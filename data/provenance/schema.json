{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paddyspeaks.com/data/provenance/schema.json",
  "title": "PaddySpeaks provenance record",
  "description": "See docs/PROVENANCE.md. Honesty rules beyond this schema are enforced by scripts/platform_build/checks.py.",
  "type": "object",
  "required": ["id", "type", "url", "title", "sources", "status", "editor"],
  "properties": {
    "id": { "type": "string" },
    "type": { "enum": ["sacred-text", "article", "dataset"] },
    "url": { "type": "string", "pattern": "^/" },
    "title": { "type": "string" },
    "work": { "type": "object", "properties": { "title": { "type": "string" }, "language": { "type": "string" } } },
    "attribution": {
      "type": "object",
      "properties": { "composer": { "type": "string" }, "traditionalLocation": { "type": "string" }, "note": { "type": "string" } }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "label", "kind"],
        "properties": {
          "role": { "enum": ["text", "transliteration", "translation", "commentary", "reference", "data"] },
          "label": { "type": "string" },
          "url": { "type": "string", "pattern": "^(https?://|/)" },
          "kind": { "enum": ["primary", "secondary", "reference"] },
          "note": { "type": "string" }
        }
      }
    },
    "editor": { "type": "string" },
    "translation": { "type": "object", "properties": { "by": { "type": ["string", "null"] }, "note": { "type": "string" } } },
    "status": { "enum": ["verified", "source-noted", "source-not-recorded", "under-review"] },
    "statusNote": { "type": "string" },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method"],
        "properties": {
          "method": { "type": "string" }, "scope": { "type": "string" },
          "verifiedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "tool": { "type": "string" }, "runs": { "type": "string" }
        }
      }
    },
    "knownIssues": {
      "type": "array",
      "items": { "type": "object", "required": ["summary"], "properties": { "since": { "type": "string" }, "summary": { "type": "string" }, "tracking": { "type": "string" } } }
    },
    "lastReviewed": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "recordedFrom": { "type": ["string", "null"] },
    "recordedText": { "type": ["string", "null"] },
    "citation": { "type": "object", "properties": { "scheme": { "type": "string" }, "example": { "type": ["string", "null"] } } }
  }
}
