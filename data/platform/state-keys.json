{
  "$comment": "Every browser-storage key PaddySpeaks writes, by product. lib/ps-state.js reads this to show people what is stored and to clear it. Add a key here when you add one to the code — scripts/platform_build/checks.py fails CI if a localStorage key in the code is missing from this file. 'match' is 'exact' or 'prefix'. Keys are NOT renamed or migrated: products keep their existing keys, this registry only makes them visible and clearable.",
  "products": [
    {
      "id": "platform",
      "label": "PaddySpeaks (Continue module)",
      "keys": [
        { "key": "ps.recent.v1", "match": "exact", "what": "Last pages you opened, for 'continue where you left off'" }
      ]
    },
    {
      "id": "jobs",
      "label": "JobSignal",
      "keys": [
        { "key": "jsig_pipeline_v1", "match": "exact", "what": "Saved jobs, application stages and hidden roles" },
        { "key": "jsig_alerts_v1", "match": "exact", "what": "Job alerts you set up" }
      ],
      "session": [
        { "key": "jsig_index_v1", "match": "exact", "what": "Cached job index for this tab" }
      ]
    },
    {
      "id": "interview",
      "label": "Interview Studio",
      "keys": [
        { "key": "qb.set.v1", "match": "exact", "what": "Questions you picked" },
        { "key": "qb.filters.v1", "match": "exact", "what": "Question-bank filters" },
        { "key": "pg.sql.", "match": "prefix", "what": "SQL playground: last question, runtime and your code" },
        { "key": "pg.py.", "match": "prefix", "what": "Python playground: last question and your code" },
        { "key": "ps-favs", "match": "exact", "what": "Favourite Skill Check questions" },
        { "key": "ps-history", "match": "exact", "what": "Skill Check history" },
        { "key": "ps-attempts", "match": "exact", "what": "Skill Check attempts" },
        { "key": "ps-votes", "match": "exact", "what": "Question votes" },
        { "key": "paddyspeaks.skillcheck.", "match": "prefix", "what": "Skill Check progress and filters" },
        { "key": "ps-activity-days", "match": "exact", "what": "Days you practised" },
        { "key": "ps-cards", "match": "exact", "what": "Flashcard progress" },
        { "key": "ps-plan", "match": "exact", "what": "30-day study plan" },
        { "key": "ps-plan-start", "match": "exact", "what": "Study plan start date" },
        { "key": "ps-sim", "match": "exact", "what": "Simulator state" },
        { "key": "ps-track-", "match": "prefix", "what": "Track progress" },
        { "key": "ps-lb-entries", "match": "exact", "what": "Your leaderboard entries and their deletion tokens" },
        { "key": "ps-mock-key", "match": "exact", "what": "Your own Anthropic API key (AI mock interview)", "sensitive": true },
        { "key": "ps-mock-model", "match": "exact", "what": "AI mock interview model choice" },
        { "key": "dm-studio-", "match": "prefix", "what": "Data-modeling studio progress and theme" },
        { "key": "ps-theme", "match": "exact", "what": "Light/dark preference" }
      ]
    },
    {
      "id": "sacred",
      "label": "Sacred texts",
      "keys": [
        { "key": "narayaneeyam-visited", "match": "exact", "what": "Narayaneeyam reading position" }
      ]
    },
    {
      "id": "privacy",
      "label": "Privacy Console",
      "keys": [
        { "key": "ps-privacy-v1", "match": "exact", "what": "Your identity profile, scored results and removal tracker", "sensitive": true }
      ]
    },
    {
      "id": "privacy-command-center",
      "label": "Privacy Command Center (demo)",
      "keys": [
        { "key": "pcc.persona.v1", "match": "exact", "what": "The role you chose to view the demo as (e.g. Security VP)" }
      ]
    },
    {
      "id": "careeros",
      "label": "CareerOS prototype",
      "keys": [
        { "key": "careeros-state-v1", "match": "exact", "what": "Prototype state" }
      ],
      "session": [
        { "key": "icfd-greeted", "match": "exact", "what": "IC FlightDeck greeting shown" }
      ]
    },
    {
      "id": "analytics",
      "label": "Site analytics",
      "keys": [
        { "key": "_ps_vid", "match": "exact", "what": "Random visitor ID (pseudonymous)" },
        { "key": "_ps_first", "match": "exact", "what": "Date of your first visit" }
      ],
      "session": [
        { "key": "_ps_", "match": "prefix", "what": "Session ID, page count and campaign tags for this visit" }
      ]
    }
  ]
}
