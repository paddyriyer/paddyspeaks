{
  "$comment": "The career taxonomy for the Interview Studio. Add a role or a family HERE; the jobs pipeline (classify.py), the jobs page and Career Prep all read it, so no UI code changes. Roles are matched to job titles by title_patterns in the order listed (first match wins), so put specific roles before general ones. See docs/CAREER-PREP.md.",
  "seniority": [
    { "id": "entry", "label": "Entry" },
    { "id": "associate", "label": "Associate" },
    { "id": "mid", "label": "Mid" },
    { "id": "senior", "label": "Senior" },
    { "id": "staff_principal", "label": "Staff / Principal" },
    { "id": "director", "label": "Director+" }
  ],
  "exclude_title_patterns": ["\\bproduct design\\b", "\\bdesigner\\b", "\\bux\\b"],
  "seniority_patterns": [
    { "level": "director", "pattern": "\\b(director|head of|vice president|vp\\b|chief)" },
    { "level": "staff_principal", "pattern": "\\b(principal|staff|distinguished|group product manager|lead product manager)\\b" },
    { "level": "senior", "pattern": "\\b(senior|sr\\.?|iii|lead)\\b" },
    { "level": "associate", "pattern": "\\b(associate|apm|junior|jr\\.?)\\b" },
    { "level": "entry", "pattern": "\\b(intern|internship|new grad|graduate|entry[- ]level|early career|werkstudent|gyakornok|trainee)\\b" }
