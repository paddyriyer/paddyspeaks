# Security headers for paddyspeaks.com (P0.6) — docs/SECURITY.md
#
# IMPORTANT: this file is honoured by Cloudflare Pages and Netlify. The site
# is currently served by GitHub Pages (see privacy/app.js), which IGNORES it.
# Until hosting moves, apply the same values as a Cloudflare "Modify Response
# Header" Transform Rule on the paddyspeaks.com zone — the exact steps are in
# docs/SECURITY.md#static-site-headers. Keep the two in step.
#
# The CSP is REPORT-ONLY on purpose: 256 pages still carry inline scripts and
# 102 carry inline event handlers, so an enforcing policy needs 'unsafe-inline'
# today. Report-only shows what a stricter policy would break without breaking it.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://d3js.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://ps.paddyspeaks.com https://api.anthropic.com https://cdn.jsdelivr.net; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://docs.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://docs.google.com; frame-ancestors 'self'

# Admin pages: never framed, never cached, never indexed.
/analytics/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/testimonials/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Platform data: short cache so a correction or registry change shows quickly.
/data/*
  Cache-Control: public, max-age=300
